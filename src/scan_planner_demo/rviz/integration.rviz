Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: scan_demo_map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Local map
      Enabled: true
      Topic:
        Value: /scan_demo/local_map
        Reliability Policy: Best Effort
      Size (m): 0.05
    - Class: rviz_default_plugins/RobotModel
      Name: Go2
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/Path
      Name: Global path
      Enabled: true
      Topic:
        Value: /scan_demo/global_path
        Durability Policy: Transient Local
      Color: 50; 100; 255
    - Class: rviz_default_plugins/Path
      Name: Local trajectory
      Enabled: true
      Topic:
        Value: /scan_demo/scan_planner/local_path
        Durability Policy: Transient Local
      Color: 0; 220; 80
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Focal Point:
        X: 3
        Y: 1
        Z: 0.4
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Width: 1400
  Height: 900
