Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: scan_demo_map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Local map
      Enabled: true
      Topic:
        Value: /scan_demo/local_map
        Reliability Policy: Best Effort
      Size (m): 0.05
    - Class: rviz_default_plugins/RobotModel
      Name: Go2
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/Path
      Name: Global path
      Enabled: true
      Topic:
        Value: /scan_demo/global_path
        Durability Policy: Transient Local
      Color: 50; 100; 255
    - Class: rviz_default_plugins/Path
      Name: Local trajectory
      Enabled: true
      Topic:
        Value: /scan_demo/scan_planner/local_path
        Durability Policy: Transient Local
      Color: 0; 220; 80
