<?xml version="1.0"?>
<package format="3">
  <name>scan_planner</name><version>0.2.0</version>
  <description>ROS 2 SCAN local planning, guarded velocity control, and ROS-independent C++ core.</description>
  <maintainer email="zhoujinghao188@gmail.com">Jinghao</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>scan_planner_msgs</depend>
  <depend>eigen</depend><depend>rclcpp</depend><depend>builtin_interfaces</depend>
